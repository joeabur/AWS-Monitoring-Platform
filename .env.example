# Generate a local secret with: python -c 'import secrets; print(secrets.token_hex(32))'
JWT_SECRET_KEY=
DATABASE_URL=postgresql+psycopg://monitor:monitor-local-only@db:5432/monitoring
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development
MIGRATIONS_ON_STARTUP=true
# Comma-separated allowlists; related detections stay disabled while these are empty.
EXPECTED_IAM_USERS=
TRUSTED_IP_CIDRS=
SENSITIVE_RESOURCE_ARNS=
# JSON list; role_arn is optional for local AWS credential-chain development.
# response_role_arn/response_external_id must name a separate, narrowly scoped write role;
# response_allowed_iam_users is an explicit per-account target allowlist for live key disable.
MONITORED_AWS_ACCOUNTS=[]
# Response is unavailable by default; live execution requires both explicit opt-in settings.
RESPONSE_ACTIONS_ENABLED=false
RESPONSE_DRY_RUN=true
# Optional notifications; webhook URLs must use HTTPS. No destinations are configured by default.
NOTIFICATION_MIN_SEVERITY=high
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
NOTIFICATION_EMAIL_FROM=
NOTIFICATION_EMAIL_TO=
